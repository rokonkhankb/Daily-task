rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'rokonkhankb12@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    match /tasks/{taskId} {
      // Shared task tracking for the entire team
      allow read, write: if true;
    }

    match /teamMembers/{memberId} {
      // Full team member management (add, update role, remove)
      allow read, write: if true;
    }

    match /test/connection {
      allow read, write: if true;
    }
  }
}
